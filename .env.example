# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MONITOR_CHAT_ID=
TELEGRAM_MONITOR_TOPIC_ID=

# Site
MASSAGEMHUB_BASE_URL=https://massagemhub.com.br
SEND_SUCCESS_SUMMARY=true
MONITOR_TIMEOUT_MS=15000

# Pacote 2 - E2E (opcionais)
MASSAGEMHUB_ADVERTISER_EMAIL=
MASSAGEMHUB_ADVERTISER_PASSWORD=
MASSAGEMHUB_ADMIN_EMAIL=
MASSAGEMHUB_ADMIN_PASSWORD=
E2E_TIMEOUT_MS=20000
E2E_SCREENSHOTS=false

# Pacote 3 - perfil público sentinela (opcional)
MASSAGEMHUB_SENTINEL_PUBLIC_URL=
MASSAGEMHUB_SENTINEL_EXPECT=

# Pacote 3 - Google Search Console (opcional)
# No GitHub use um Secret, não versione o JSON real.
GOOGLE_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:massagemhub.com.br
GSC_MIN_IMPRESSIONS=50
GSC_MIN_CLICKS=10
GSC_IMPRESSIONS_DROP_PCT=40
GSC_CLICKS_DROP_PCT=50
GSC_POSITION_WORSE_BY=5
GSC_FAIL_ON_ALERT=false
